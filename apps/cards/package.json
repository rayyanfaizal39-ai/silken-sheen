    "@tanstack/start-server-core": "1.169.44",
    "lucide-react": "0.575.0",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@lovable.dev/vite-tanstack-config": "2.23.1",
    "@tailwindcss/vite": "4.3.1",
    "@types/node": "22.20.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "nitro": "3.0.260603-beta",
    "typescript": "5.9.3",
