# Use this exact controlled hostname so the existing .myacademy.my session
# cookie and the main application's explicit return allowlist both apply.
VITE_CARDS_SITE_URL=https://preview.cards.myacademy.my
# Main preview origin. Login only shares the session when this is also a
# .myacademy.my host listed in Main's supabase-auth-cookie.ts; otherwise
# return links work but students must sign in on each preview separately.
VITE_MAIN_SITE_URL=https://www.myacademy.my
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your-key
NOVA_AI_ENABLED=false
NOVA_AI_BATCH_ENABLED=false
