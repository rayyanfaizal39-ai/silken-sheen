# Browser-safe values only. Configure both in the Cloudflare Pages dashboard.
VITE_CARDS_SITE_URL=https://cards.myacademy.my
# Main AcadeMY origin for login, upgrade and return links (defaults to production).
VITE_MAIN_SITE_URL=https://www.myacademy.my
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key

# Server-side aliases for the same public project values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your-key

# Keep paid generation disabled until the separately approved activation phase.
NOVA_AI_ENABLED=false
NOVA_AI_BATCH_ENABLED=false
